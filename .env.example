# ============================================================
# Inventario de Camisas — Variables de entorno
# Copia este archivo como .env y completa los valores reales.
# NUNCA subir .env al repositorio (contiene secretos).
# ============================================================

# --- Base de datos ---
# Local: localhost / 3306. En AWS: host del RDS.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventario_camisas
DB_USER=root
DB_PASSWORD=cambia_esto
# Nombre del secreto en AWS Secrets Manager con la contrasena de RDS.
# Si DB_PASSWORD esta vacio y DB_SECRET_NAME esta definido, la app y el
# script de reporte resuelven la contrasena desde Secrets Manager con el
# rol IAM de la instancia (secreto gestionado por RDS: JSON con password).
DB_SECRET_NAME=

# --- AWS S3 ---
# Dejar vacío si aun no se tienen credenciales; la app funciona sin S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=
# Duracion de la URL firmada en segundos (por defecto 300 = 5 minutos)
S3_URL_EXPIRY=300